# Kopiraj ovaj fajl kao .env na serveru i popuni vrijednosti
# cp .env.example .env

PORT=3010
NODE_ENV=production

# Frontend URL (za CORS)
FRONTEND_URL=https://karpas.app

# Database (vlastita baza aplikacije, vidi docs/schema.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=struja
DB_PASSWORD=OVDJE_UPISITE_LOZINKU
DB_NAME=racuni_struja

# Prijava u aplikaciju (jedan korisnik)
# Hash se dobija komandom: npm run lozinka
APP_USERNAME=OVDJE_UPISITE_KORISNICKO_IME
APP_PASSWORD_HASH=OVDJE_UPISITE_HASH_LOZINKE

# JWT
JWT_SECRET=OVDJE_UPISITE_TAJNI_KLJUC_MIN_32_KARAKTERA
JWT_EXPIRES_IN=30d
