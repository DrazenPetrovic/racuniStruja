# Kopiraj ovaj fajl kao .env na serveru i popuni vrijednosti
# cp .env.example .env

# Na serveru 3010 koristi sistem monitor
PORT=3011
NODE_ENV=production

# Frontend URL (za CORS)
FRONTEND_URL=https://karpas.app

# Database (vlastita baza aplikacije, vidi docs/schema.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=struja
DB_PASSWORD=OVDJE_UPISITE_LOZINKU
DB_NAME=racuni_struja

# Prijava u aplikaciju (jedan korisnik)
# Hash se dobija komandom: npm run lozinka
APP_USERNAME=OVDJE_UPISITE_KORISNICKO_IME
APP_PASSWORD_HASH=OVDJE_UPISITE_HASH_LOZINKE

# JWT
JWT_SECRET=OVDJE_UPISITE_TAJNI_KLJUC_MIN_32_KARAKTERA
JWT_EXPIRES_IN=30d

# Slanje stanja brojila emailom (dugme "Pošalji stanje Elektrokrajini")
# GMAIL_APP_PASSWORD: Google račun > Sigurnost > 2-Step Verification ukljucen > App passwords (16 slova)
GMAIL_USER=OVDJE_UPISITE_GMAIL_ADRESU
GMAIL_APP_PASSWORD=OVDJE_UPISITE_APP_PASSWORD
# Za testiranje upisi svoju drugu adresu, a za pravo slanje callcentar@elektrokrajina.com
EMAIL_PRIMALAC=callcentar@elektrokrajina.com
BROJ_BROJILA=OVDJE_UPISITE_BROJ_BROJILA
IME_PREZIME=OVDJE_UPISITE_IME_I_PREZIME
ADRESA=OVDJE_UPISITE_ADRESU
